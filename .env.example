ANDROID_EMULATOR_DATA_DIR=./data
ANDROID_EMULATOR_MAX_APK_BYTES=536870912

ANDROID_EMULATOR_RUNTIME_DRIVER=docker
ANDROID_EMULATOR_REDROID_IMAGE=redroid/redroid:15.0.0-latest
ANDROID_EMULATOR_RUNTIME_NAME=android-emulator-redroid
ANDROID_EMULATOR_RUNTIME_VOLUME=android-emulator-data

# ADB must remain loopback-only. Settings reject public/non-loopback hosts.
ANDROID_EMULATOR_ADB_HOST=127.0.0.1
ANDROID_EMULATOR_ADB_PORT=5555
ANDROID_EMULATOR_BOOT_TIMEOUT_SECONDS=120
ANDROID_EMULATOR_ADB_BIN=adb
ANDROID_EMULATOR_AAPT_BIN=aapt
ANDROID_EMULATOR_DOCKER_BIN=docker

# Replace this with the HTTPS URL through which the iPhone reaches MediaMTX/WHEP.
ANDROID_EMULATOR_STREAM_PUBLIC_BASE_URL=http://127.0.0.1:8889
ANDROID_EMULATOR_STREAM_WHEP_PATH=/android/session/whep
# RTSP ingest is intentionally loopback-only and must not be published publicly.
ANDROID_EMULATOR_STREAM_RTSP_URL=rtsp://127.0.0.1:8554/android/session
ANDROID_EMULATOR_STREAM_WIDTH=720
ANDROID_EMULATOR_STREAM_HEIGHT=1280
ANDROID_EMULATOR_STREAM_FPS=30
ANDROID_EMULATOR_STREAM_BITRATE=4000000
ANDROID_EMULATOR_STREAM_CAPTURE_SECONDS=175
ANDROID_EMULATOR_STREAM_START_TIMEOUT_SECONDS=3
ANDROID_EMULATOR_FFMPEG_BIN=ffmpeg
